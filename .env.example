# NeuroScan reads these as ENVIRONMENT VARIABLES (it does not load this file).
# In PowerShell set one for the current terminal, e.g.:
#   $env:NEUROSCAN_MAX_UPLOAD_MB = "20"
# All are optional; the defaults are shown.

NEUROSCAN_MODEL_DIR=model                  # folder with best_model.keras, metadata.json, ood_stats.npz
NEUROSCAN_HISTORY_DB=backend/data/history.db
NEUROSCAN_HISTORY_ENABLED=true
NEUROSCAN_MAX_UPLOAD_MB=10
NEUROSCAN_MAX_PIXELS=40000000
NEUROSCAN_MAX_SIDE=8192
NEUROSCAN_MIN_SIDE=64
NEUROSCAN_INFERENCE_TIMEOUT_S=60
NEUROSCAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEUROSCAN_FRONTEND_DIST=frontend/dist      # served at / when it exists

# Frontend (Vite dev server only): where /api is proxied to
NEUROSCAN_API_URL=http://127.0.0.1:8000
